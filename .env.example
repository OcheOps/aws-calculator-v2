# --- Postgres ---
POSTGRES_USER=awscalc
POSTGRES_PASSWORD=change-me
POSTGRES_DB=awscalc

# --- API ---
API_LISTEN_ADDR=:8080
API_DATABASE_URL=postgres://awscalc:change-me@postgres:5432/awscalc?sslmode=disable
API_LOG_LEVEL=info
API_ENV=development
ADMIN_TOKEN=change-me

# --- AWS (used in later plans) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_PRICING_REGION=us-east-1
INGEST_CRON=0 3 * * *
INGEST_MODE=bulk
INGEST_REGION_CONCURRENCY=3
INGEST_BATCH_SIZE=5000

# --- FX ---
FX_API_URL=https://open.er-api.com
FX_CRON=@hourly

# --- SMTP / Brevo (used in later plans) ---
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=no-reply@example.com

# --- Web ---
PUBLIC_BASE_URL=http://localhost
PUBLIC_API_URL=http://api:8080
